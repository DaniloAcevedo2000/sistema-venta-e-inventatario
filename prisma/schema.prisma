// ============================================
// NEXTAUTH
// ============================================

model Cuenta {
  id           String  @id @default(cuid())
  usuarioId    String  @map("usuario_id")
  tipo         String
  proveedor    String  @map("proveedor")
  proveedorId  String  @map("proveedor_id")
  refreshToken String? @map("refresh_token") @db.Text
  accessToken  String? @map("access_token") @db.Text
  expiraEn     Int?    @map("expira_en")
  tokenType    String? @map("token_type")
  scope        String?
  idToken      String? @map("id_token") @db.Text
  sessionState String? @map("session_state")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, proveedorId])
  @@map("cuentas")
}

model Sesion {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  usuarioId    String   @map("usuario_id")
  expira       DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

model TokenVerificacion {
  identificador String   @unique
  token         String   @unique
  expira        DateTime

  @@map("tokens_verificacion")
}

// ============================================
// CONFIGURACIÓN DE PAGOS
// ============================================

model MetodoPago {
  id          String  @id @default(cuid())
  codigo      String  @unique // "EFECTIVO_NIO", "TARJETA", etc.
  nombre      String // "Efectivo C$", "Tarjeta"
  descripcion String?

  // Tipo: "efectivo", "tarjeta", "transferencia", "credito"
  tipo String

  // ¿Requiere moneda específica?
  monedaId String? @map("moneda_id")
  moneda   Moneda? @relation(fields: [monedaId], references: [id])

  // ¿Requiere banco? (para tarjeta y transferencia)
  requiereBanco Boolean @default(false) @map("requiere_banco")

  // ¿Requiere red de tarjeta? (solo tarjeta)
  requiereRed Boolean @default(false) @map("requiere_red")

  // ¿Requiere referencia/voucher?
  requiereReferencia Boolean @default(false) @map("requiere_referencia")

  // ¿Es pago a crédito?
  esCredito Boolean @default(false) @map("es_credito")

  icono  String? // nombre de icono Lucide
  orden  Int     @default(0)
  activo Boolean @default(true)

  pagos PagoVenta[]

  pedidos Pedido[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([activo, orden])
  @@map("metodos_pago")
}

model Banco {
  id          String  @id @default(cuid())
  codigo      String  @unique // "BAC", "BANPRO"
  nombre      String // "BAC Credomatic"
  nombreCorto String? @map("nombre_corto") // "BAC"

  permiteTarjeta       Boolean @default(true) @map("permite_tarjeta")
  permiteTransferencia Boolean @default(true) @map("permite_transferencia")

  pagos PagoVenta[]

  icono  String?
  color  String?
  orden  Int     @default(0)
  activo Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([activo, orden])
  @@map("bancos")
}

model RedTarjeta {
  id     String  @id @default(cuid())
  codigo String  @unique // "VISA", "MASTERCARD"
  nombre String // "Visa"
  icono  String?
  orden  Int     @default(0)
  activo Boolean @default(true)

  pagos PagoVenta[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([activo, orden])
  @@map("redes_tarjeta")
}

model Moneda {
  id      String  @id @default(cuid())
  codigo  String  @unique // "NIO", "USD"
  nombre  String // "Córdoba Nicaragüense"
  simbolo String // "C$", "$"
  esBase  Boolean @default(false) @map("es_base")
  activo  Boolean @default(true)

  metodosPago MetodoPago[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("monedas")
}

// ============================================
// TASA DE CAMBIO (histórico)
// ============================================

model TasaCambio {
  id            String    @id @default(cuid())
  monedaOrigen  String    @map("moneda_origen") // "USD"
  monedaDestino String    @map("moneda_destino") // "NIO"
  tasa          Decimal   @db.Decimal(12, 6) // 36.624300
  fuente        String    @default("MANUAL") // "MANUAL", "BCN"
  vigenteDesde  DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta  DateTime? @map("vigente_hasta") // null si es la actual
  activa        Boolean   @default(true)
  notas         String?

  usuarioId String? @map("usuario_id")

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([monedaOrigen, monedaDestino, activa])
  @@index([vigenteDesde])
  @@map("tasas_cambio")
}

// ============================================
// PEDIDOS Y DELIVERY
// ============================================

model ZonaEntrega {
  id          String  @id @default(cuid())
  codigo      String  @unique
  nombre      String // "Centro", "Cercano", "Lejano"
  descripcion String?

  // Tarifa de envío
  tarifa Decimal @db.Decimal(12, 2)

  // Tiempo estimado de entrega
  tiempoEstimadoMin Int? @map("tiempo_estimado_min")

  color  String? // para UI
  orden  Int     @default(0)
  activa Boolean @default(true)

  // Relaciones
  pedidos Pedido[]

  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  sucursal      Sucursal? @relation(fields: [sucursalId], references: [id])
  sucursalId    String?

  @@index([activa, orden])
  @@map("zonas_entrega")
}

model Pedido {
  id             String @id @default(cuid())
  numero         String @unique // "P-2026-00001"
  numeroSucursal Int    @map("numero_sucursal")

  // Tipo: DELIVERY o PICKUP
  tipo String // "DELIVERY", "PICKUP"

  // Estado del pedido
  estado String @default("PENDIENTE")
  // "PENDIENTE", "CONFIRMADO", "EN_PREPARACION", "LISTO", "EN_CAMINO", "ENTREGADO", "CANCELADO"

  // Sucursal donde se prepara
  sucursalId String   @map("sucursal_id")
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  // Cliente (opcional - puede ser cliente ocasional)
  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // Datos del cliente (snapshot al momento del pedido)
  clienteNombre    String  @map("cliente_nombre")
  clienteTelefono  String  @map("cliente_telefono")
  clienteDireccion String? @map("cliente_direccion") // solo para delivery

  latitud         Float?
  longitud        Float?

  // Zona de entrega (solo delivery)
  zonaEntregaId String?      @map("zona_entrega_id")
  zonaEntrega   ZonaEntrega? @relation(fields: [zonaEntregaId], references: [id])

  // Usuario que creó el pedido (cajero/admin)
  usuarioCreacionId String  @map("usuario_creacion_id")
  usuarioCreacion   Usuario @relation("PedidoCreadoPor", fields: [usuarioCreacionId], references: [id])

  // Repartidor asignado (solo delivery)
  repartidorId String?  @map("repartidor_id")
  repartidor   Usuario? @relation("PedidoRepartidor", fields: [repartidorId], references: [id])

  // Hora programada (opcional)
  fechaProgramada DateTime? @map("fecha_programada")

  // Totales
  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  descuento  Decimal @default(0) @db.Decimal(12, 2)
  impuesto   Decimal @default(0) @db.Decimal(12, 2)
  costoEnvio Decimal @default(0) @map("costo_envio") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  // Pago
  estadoPago   String      @default("PENDIENTE") @map("estado_pago")
  // "PENDIENTE", "PAGADO", "CONTRA_ENTREGA", "CANCELADO"
  metodoPagoId String?     @map("metodo_pago_id")
  metodoPago   MetodoPago? @relation(fields: [metodoPagoId], references: [id])

  // Ventas y facturas generadas
  ventaId String? @unique @map("venta_id")
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  // Notas
  notas         String?
  notasInternas String? @map("notas_internas") // para cocina/barista

  // Timestamps del flujo
  confirmadoEn      DateTime? @map("confirmado_en")
  preparacionEn     DateTime? @map("preparacion_en")
  listoEn           DateTime? @map("listo_en")
  enCaminoEn        DateTime? @map("en_camino_en")
  entregadoEn       DateTime? @map("entregado_en")
  canceladoEn       DateTime? @map("cancelado_en")
  motivoCancelacion String?   @map("motivo_cancelacion")

  // Auditoría
  items ItemPedido[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([sucursalId, numeroSucursal])
  @@index([estado, creadoEn])
  @@index([tipo, estado])
  @@index([sucursalId, estado])
  @@index([repartidorId, estado])
  @@index([clienteId])
  @@index([creadoEn])
  @@map("pedidos")
}

model ItemPedido {
  id       String @id @default(cuid())
  pedidoId String @map("pedido_id")
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  varianteId String?           @map("variante_id")
  variante   ProductoVariante? @relation(fields: [varianteId], references: [id])

  // Snapshot
  nombreProducto String  @map("nombre_producto")
  nombreVariante String? @map("nombre_variante")

  cantidad       Decimal @db.Decimal(12, 4)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 4)
  descuento      Decimal @default(0) @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)
  impuesto Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  tipoImpuesto String @default("GRAVADO_15") @map("tipo_impuesto")

  notas String?

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}
